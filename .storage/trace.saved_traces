          "config": {
            "id": "1792313899053",
            "alias": "Heizung Ess-Zimmer - Manueller Thermostat Boost",
            "description": "Erkennt eine manuelle \u00c4nderung der Solltemperatur am Thermostat, wartet auf die Aktualisierung der \u00c4nderungsquelle, \u00fcbernimmt die manuell gew\u00e4hlte Temperatur als Hand-Boost-Temperatur und startet den Hand-Boost-Timer.\n",
            "triggers": [
              {
                "trigger": "state",
                "entity_id": "climate.0x4c97a1fffe0bf615",
                "attribute": "temperature"
              }
            ],
            "conditions": [
              {
                "condition": "template",
                "value_template": "{{ trigger.from_state is not none\n   and trigger.to_state is not none\n   and trigger.from_state.attributes.temperature !=\n       trigger.to_state.attributes.temperature }}\n"
              }
            ],
            "actions": [
              {
                "delay": {
                  "seconds": 2
                }
              },
              {
                "condition": "state",
                "entity_id": "sensor.0x4c97a1fffe0bf615_setpoint_change_source",
                "state": "manual"
              },
              {
                "action": "input_number.set_value",
                "target": {
                  "entity_id": "input_number.hand_boost_temperatur_ess_zimmer"
                },
                "data": {
                  "value": "{{ trigger.to_state.attributes.temperature | float }}\n"
                }
              },
              {
                "action": "input_boolean.turn_off",
                "target": {
                  "entity_id": "input_boolean.heizung_ess_zimmer_heizperiode_beendet"
                }
              },
              {
                "action": "timer.start",
                "target": {
                  "entity_id": "timer.esszimmer_hand_timer_heizung_boost"
                },
                "data": {
                  "duration": "{{ states('input_datetime.esszimmer_heizung_hand_boost_dauer') }}\n"
                }
              }
            ],
            "mode": "restart"
          },
          "blueprint_inputs": null,
