          "config": {
            "id": "1792241357804",
            "alias": "Jalousie: D\u00e4mmerungssteuerung mit Offset",
            "description": "Robuste Jalousiesteuerung anhand der b\u00fcrgerlichen Morgen- und Abendd\u00e4mmerung mit positivem oder negativem Offset. \u00d6ffnungs- und Schlie\u00dfzeiten f\u00fcr heute und den Folgetag werden persistent gespeichert. Nach Neustart werden veraltete Werte erkannt. Falls nach einem langen Stromausfall keine aktuellen D\u00e4mmerungszeiten mehr rekonstruiert werden k\u00f6nnen, wird f\u00fcr den aktuellen Tag ein Notbetrieb mit 08:00 Uhr \u00d6ffnen und 18:00 Uhr Schlie\u00dfen verwendet. Fahrbefehle werden unabh\u00e4ngig vom gemeldeten open/closed-Zustand gesendet, da Zigbee2MQTT zeitweise einen veralteten Zustand melden kann.\n",
            "triggers": [
              {
                "trigger": "time",
                "at": "00:01:00",
                "id": "tageswechsel"
              },
              {
                "trigger": "time",
                "at": "23:00:00",
                "id": "morgen_vorbereiten"
              },
              {
                "trigger": "time",
                "at": "input_datetime.jalousie_oeffnungszeit",
                "id": "oeffnen"
              },
              {
                "trigger": "time",
                "at": "input_datetime.jalousie_schliesszeit",
                "id": "schliessen"
              },
              {
                "trigger": "state",
                "entity_id": "input_number.offset_morgendaemmerung",
                "id": "offset_morgen"
              },
              {
                "trigger": "state",
                "entity_id": "input_number.offset_abenddaemmerung",
                "id": "offset_abend"
              },
              {
                "trigger": "homeassistant",
                "event": "start",
                "id": "system_start"
              },
              {
                "trigger": "event",
                "event_type": "automation_reloaded",
                "id": "reload"
              },
              {
                "trigger": "time",
                "at": "08:05:00",
                "id": "sicherheitspruefung"
              },
              {
                "trigger": "time",
                "at": "18:05:00",
                "id": "sicherheitspruefung"
              }
            ],
            "conditions": [],
            "actions": [
              {
                "if": [
                  {
                    "condition": "trigger",
                    "id": "system_start"
                  }
                ],
                "then": [
                  {
                    "wait_template": "{{\n  states('sun.sun')\n    not in ['unknown', 'unavailable']\n  and\n  states('cover.0x842712fffebb9c51')\n    not in ['unknown', 'unavailable']\n}}\n",
                    "timeout": "00:02:00",
                    "continue_on_timeout": true
                  },
                  {
                    "delay": {
                      "seconds": 5
                    }
                  }
                ]
              },
              {
                "if": [
                  {
                    "condition": "trigger",
                    "id": "tageswechsel"
                  }
                ],
                "then": [
                  {
                    "choose": [
                      {
                        "conditions": [
                          {
                            "condition": "template",
                            "value_template": "{% set heute = now().strftime('%Y-%m-%d') %}\n{% set auf =\n  state_attr(\n    'input_datetime.jalousie_oeffnungszeit_morgen',\n    'timestamp'\n  ) | float(0)\n%}\n{% set zu =\n  state_attr(\n    'input_datetime.jalousie_schliesszeit_morgen',\n    'timestamp'\n  ) | float(0)\n%}\n{{\n  auf > 0\n  and zu > 0\n  and\n  (\n    auf\n    | timestamp_custom('%Y-%m-%d', true)\n  ) == heute\n  and\n  (\n    zu\n    | timestamp_custom('%Y-%m-%d', true)\n  ) == heute\n}}\n"
                          }
                        ],
                        "sequence": [
                          {
                            "action": "input_datetime.set_datetime",
                            "target": {
                              "entity_id": "input_datetime.jalousie_oeffnungszeit"
                            },
                            "data": {
                              "timestamp": "{{\n  state_attr(\n    'input_datetime.jalousie_oeffnungszeit_morgen',\n    'timestamp'\n  )\n}}\n"
                            }
                          },
                          {
                            "action": "input_datetime.set_datetime",
                            "target": {
                              "entity_id": "input_datetime.jalousie_schliesszeit"
                            },
                            "data": {
                              "timestamp": "{{\n  state_attr(\n    'input_datetime.jalousie_schliesszeit_morgen',\n    'timestamp'\n  )\n}}\n"
                            }
                          }
                        ]
                      }
                    ],
                    "default": [
                      {
                        "choose": [
                          {
                            "conditions": [
                              {
                                "condition": "template",
                                "value_template": "{% set heute =\n  now().strftime('%Y-%m-%d')\n%}\n{% set dawn =\n  as_timestamp(\n    state_attr('sun.sun', 'next_dawn')\n  ) | float(0)\n%}\n{% set dusk =\n  as_timestamp(\n    state_attr('sun.sun', 'next_dusk')\n  ) | float(0)\n%}\n{{\n  dawn > 0\n  and dusk > 0\n  and\n  (\n    dawn\n    | timestamp_custom('%Y-%m-%d', true)\n  ) == heute\n  and\n  (\n    dusk\n    | timestamp_custom('%Y-%m-%d', true)\n  ) == heute\n}}\n"
                              }
                            ],
                            "sequence": [
                              {
                                "action": "input_datetime.set_datetime",
                                "target": {
                                  "entity_id": "input_datetime.jalousie_oeffnungszeit"
                                },
                                "data": {
                                  "timestamp": "{{\n  as_timestamp(\n    state_attr('sun.sun', 'next_dawn')\n  )\n  +\n  (\n    states(\n      'input_number.offset_morgendaemmerung'\n    ) | float(0)\n  ) * 60\n}}\n"
                                }
                              },
                              {
                                "action": "input_datetime.set_datetime",
                                "target": {
                                  "entity_id": "input_datetime.jalousie_schliesszeit"
                                },
                                "data": {
                                  "timestamp": "{{\n  as_timestamp(\n    state_attr('sun.sun', 'next_dusk')\n  )\n  +\n  (\n    states(\n      'input_number.offset_abenddaemmerung'\n    ) | float(0)\n  ) * 60\n}}\n"
                                }
                              }
                            ]
                          }
                        ],
                        "default": [
                          {
                            "action": "input_datetime.set_datetime",
                            "target": {
                              "entity_id": "input_datetime.jalousie_oeffnungszeit"
                            },
                            "data": {
                              "timestamp": "{{\n  as_timestamp(\n    today_at('08:00')\n  )\n}}\n"
                            }
                          },
                          {
                            "action": "input_datetime.set_datetime",
                            "target": {
                              "entity_id": "input_datetime.jalousie_schliesszeit"
                            },
                            "data": {
                              "timestamp": "{{\n  as_timestamp(\n    today_at('18:00')\n  )\n}}\n"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "if": [
                  {
                    "condition": "trigger",
                    "id": "morgen_vorbereiten"
                  }
                ],
                "then": [
                  {
                    "choose": [
                      {
                        "conditions": [
